# ==========================================
# 1. CORE API & KEYS (REQUIRED FOR BACKEND & VOICE)
# ==========================================
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash-lite

SONIOX_API_KEY=
SONIOX_VOICE_ID=Grace

# Voice lesson TTS: soniox (default) or google; STT continues to use Soniox.
TTS_PROVIDER=soniox
# Required only when TTS_PROVIDER=google. Path is relative to repository root.
GOOGLE_APPLICATION_CREDENTIALS=gg.json
GOOGLE_TTS_LOCATION=asia-southeast1
GOOGLE_TTS_EN_VOICE=en-US-Chirp3-HD-Leda
GOOGLE_TTS_VI_VOICE=vi-VN-Chirp3-HD-Leda

# ==========================================
# 2. STANDALONE FREE TALK ROOM (/talk)
# ==========================================
# Free Talk reuses OPENROUTER_API_KEY and OPENROUTER_MODEL above.

# ==========================================
# 3. CORS & NETWORKING (FOR VPS & VERCEL)
# ==========================================
# Comma-separated list of allowed origins or *
ALLOWED_ORIGINS=*
PIPECAT_ALLOWED_ORIGINS=*

# Public STUN/TURN server for WebRTC audio through NAT/Firewall
PIPECAT_ICE_SERVERS=stun:stun.l.google.com:19302

# Ports configuration on host
BACKEND_PORT=8090
WEB_PORT=3001

# ==========================================
# 4. FRONTEND ENVIRONMENT VARIABLES (FOR VERCEL)
# ==========================================
# Set these in your Vercel Project Dashboard (Settings > Environment Variables)
# Replace with your VPS domain or IP (HTTPS is required on Vercel)
NEXT_PUBLIC_TUTOR_API_URL=http://localhost:8090
NEXT_PUBLIC_PIPECAT_URL=http://localhost:7860
NEXT_PUBLIC_TALK_PIPECAT_URL=http://localhost:7863
